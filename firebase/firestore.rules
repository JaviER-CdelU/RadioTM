rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /canciones/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pedidosCanciones/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'cancionId', 'artista', 'titulo', 'archivo',
          'nombre', 'ciudad', 'mensaje', 'estado', 'creadoEn', 'origen'
        ])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() >= 2
        && request.resource.data.ciudad.size() <= 80
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 250
        && request.resource.data.archivo is string;

      allow read, update, delete: if request.auth != null;
    }
  }
}
